{
  "spotify": {
    "client_id": "your_spotify_client_id_here",
    "client_secret": "your_spotify_client_secret_here",
    "redirect_uri": "http://127.0.0.1:8888/callback",
    "scope": "user-read-currently-playing user-read-playback-state",
    "update_interval": 10,
    "poll_max_interval": 10,
    "poll_paused_interval": 20,
    "poll_idle_interval": 30,
    "poll_transition_interval": 2,
    "poll_transition_window": 12,
    "comment": "Adaptive polling (seconds): poll_max_interval = mid-song ceiling that catches manual skips; paused/idle slow down the poll rate; near a track's predicted end it polls every poll_transition_interval starting poll_transition_window seconds early so new album art appears almost instantly."
  },
  "display": {
    "rows": 64,
    "cols": 64,
    "chain_length": 1,
    "parallel": 1,
    "brightness": 80,
    "hardware_mapping": "regular",
    "gpio_slowdown": 2,
    "pwm_bits": 11,
    "pwm_lsb_nanoseconds": 130,
    "led_rgb_sequence": "RGB",
    "show_refresh_rate": false
  },
  "modes": {
    "default": "music",
    "auto_switch": true,
    "schedule": {
      "weather": {
        "enabled": false,
        "times": ["06:00-09:00", "17:00-17:30"]
      },
      "music": {
        "enabled": true,
        "auto": true,
        "condition": "spotify_playing"
      },
      "sports": {
        "enabled": false,
        "times": ["18:00-23:00"],
        "condition": "game_active"
      },
      "clock": {
        "enabled": true,
        "fallback": true,
        "style": "analog",
        "comment": "style can be 'analog' or 'digital'"
      }
    }
  },
  "weather": {
    "enabled": false,
    "provider": "openweathermap",
    "api_key": "your_openweathermap_api_key_here",
    "location": "Arlington,Virginia,US",
    "units": "imperial",
    "update_interval": 600,
    "display_forecast": true
  },
  "weather_on_8s": {
    "enabled": false,
    "api_key": "your_openweathermap_api_key_here",
    "location": "Arlington,Virginia,US",
    "units": "imperial",
    "display_duration": 90,
    "comment": "Classic Weather Channel style - shows at :08, :18, :28, :38, :48, :58"
  },
  "sports": {
    "enabled": false,
    "provider": "espn",
    "league": "NFL",
    "team": "GB",
    "update_interval": 60,
    "show_scores_only_during_games": false,
    "comment": "team codes: GB=Green Bay Packers, NO=New Orleans Saints, etc."
  },
  "screensavers": {
    "pipes": {
      "enabled": true,
      "num_pipes": 4,
      "speed": 0.033,
      "fade_trail": true,
      "background_color": [0, 0, 0],
      "comment": "speed: seconds between frames (0.033 = ~30 FPS)"
    },
    "dvd_logo": {
      "enabled": true,
      "speed": 0.016,
      "logo_width": 16,
      "logo_height": 8,
      "comment": "speed: seconds between frames (0.016 = ~60 FPS)"
    }
  },
  "web_server": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 5000,
    "debug": false,
    "admin_username": "admin",
    "admin_password": "changeme",
    "secret_key": "your-secret-key-here-change-this-to-random-string"
  },
  "image_processing": {
    "enhance_contrast": true,
    "contrast_factor": 1.2,
    "enhance_saturation": true,
    "saturation_factor": 1.1,
    "cache_images": true,
    "cache_size_mb": 100
  },
  "logging": {
    "level": "INFO",
    "file": "/var/log/spotify-display.log",
    "max_size_mb": 10,
    "backup_count": 3
  },
  "advanced": {
    "transition_effects": true,
    "scroll_speed": 2,
    "text_font": "fonts/tom-thumb.bdf",
    "show_track_info": true,
    "track_info_duration": 5
  }
}
