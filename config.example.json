{
  "spotify": {
    "client_id": "your_spotify_client_id_here",
    "client_secret": "your_spotify_client_secret_here",
    "redirect_uri": "http://localhost:8888/callback",
    "scope": "user-read-currently-playing user-read-playback-state",
    "update_interval": 10
  },
  "display": {
    "rows": 64,
    "cols": 64,
    "chain_length": 1,
    "parallel": 1,
    "brightness": 80,
    "hardware_mapping": "regular",
    "gpio_slowdown": 2,
    "pwm_bits": 11,
    "pwm_lsb_nanoseconds": 130,
    "led_rgb_sequence": "RGB",
    "show_refresh_rate": false
  },
  "modes": {
    "default": "music",
    "auto_switch": true,
    "schedule": {
      "weather": {
        "enabled": true,
        "times": ["06:00-09:00", "17:00-17:30"]
      },
      "music": {
        "enabled": true,
        "auto": true,
        "condition": "spotify_playing"
      },
      "sports": {
        "enabled": true,
        "times": ["18:00-23:00"],
        "condition": "game_active"
      },
      "clock": {
        "enabled": true,
        "fallback": true
      }
    }
  },
  "weather": {
    "enabled": true,
    "provider": "openweathermap",
    "api_key": "your_openweathermap_api_key_here",
    "location": "New York,US",
    "units": "imperial",
    "update_interval": 600,
    "display_forecast": true
  },
  "weather_on_8s": {
    "enabled": true,
    "api_key": "your_openweathermap_api_key_here",
    "location": "New York,US",
    "units": "imperial",
    "display_duration": 90,
    "comment": "Classic Weather Channel style - shows at :08, :18, :28, :38, :48, :58"
  },
  "sports": {
    "enabled": true,
    "provider": "espn",
    "league": "NFL",
    "team": "NO",
    "update_interval": 60,
    "show_scores_only_during_games": false
  },
  "web_server": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 5000,
    "debug": false
  },
  "image_processing": {
    "enhance_contrast": true,
    "contrast_factor": 1.2,
    "enhance_saturation": true,
    "saturation_factor": 1.1,
    "cache_images": true,
    "cache_size_mb": 100
  },
  "logging": {
    "level": "INFO",
    "file": "/var/log/spotify-display.log",
    "max_size_mb": 10,
    "backup_count": 3
  },
  "advanced": {
    "transition_effects": true,
    "scroll_speed": 2,
    "text_font": "fonts/tom-thumb.bdf",
    "show_track_info": true,
    "track_info_duration": 5
  }
}
